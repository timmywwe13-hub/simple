# Godot 4+ specific ignores
.godot/
/android/

# stale web-export leftovers at the project root (an old export pointed at
# res:// - the real web build lives in build/web and IS committed)
/simple.js
/simple.wasm
/simple.pck
/simple.audio.worklet.js
/simple.audio.position.worklet.js
/simple.icon.png
/simple.icon.png.import
/simple.png
/simple.png.import
/simple.apple-touch-icon.png
/simple.apple-touch-icon.png.import

# Godot import sidecars generated for committed PWA art
build/web/*.import

# Surge writes this during a deploy; each mirror owns its own domain
build/web/CNAME

# Surge deploy metadata
build/web/.surge/

# Python bytecode from the web-build cache patch
__pycache__/
*.pyc
