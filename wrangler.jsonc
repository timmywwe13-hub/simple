{
  // Cloudflare Workers config for the Godot web export.
  //
  // Godot's release wasm is ~38 MiB, but Cloudflare Workers static assets
  // reject any single file over 25 MiB. scripts/cf-build.sh therefore assembles
  // `dist/` with the wasm split into ~16 MiB pieces, and worker/index.js streams
  // those pieces back as one application/wasm response.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simple",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "build": {
    "command": "bash ./scripts/cf-build.sh"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/index.wasm"]
  },
  "observability": {
    "enabled": true
  }
}
